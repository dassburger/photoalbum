__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/

# Test/tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editor/OS cruft
.DS_Store
*.swp
