# Generated site output (top-level index/static/covers only; per-album
# content is generated directly inside each album's folder under
# ~/Pictures, which is outside this repo entirely).
site/

# Generated Caddy config (machine-generated by `prep sync-routes`).
caddy/Caddyfile

# Deployment-specific config (domain, ACME email, pictures-root path).
prep.toml

